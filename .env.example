# ============================================================
#  Telegram
# ============================================================
# Токен бота от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# ============================================================
#  LLM (текстовая модель, OpenAI-совместимый API)
# ============================================================
# Ключ провайдера: OpenAI, OpenRouter, Yandex Cloud, локальный Ollama и т.п.
LLM_API_KEY=sk-example-llm-key
# Базовый URL без завершающего слэша. Пример для OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
# Имя модели у вашего провайдера
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=600
LLM_TIMEOUT=60

# ============================================================
#  Image API (картинки)
# ============================================================
# openai    -> /images/generations (DALL-E 3, gpt-image-1, любые совместимые)
# stability -> Stability AI /v2beta/stable-image/generate/core (SDXL и др.)
IMAGE_PROVIDER=openai
# Оставьте пустым при IMAGE_PROVIDER=openai, чтобы использовать LLM_API_KEY
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT=120

# ============================================================
#  Прочее
# ============================================================
LOG_LEVEL=INFO

# ============================================================
#  Хостинг
# ============================================================
# Render/Railway подставляют PORT сами — трогать не нужно.
# Задайте вручную, только если хотите поднять /healthz локально или на VPS.
# PORT=8080
