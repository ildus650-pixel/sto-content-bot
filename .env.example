# ============================================================
#  Telegram
# ============================================================
# Токен бота от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# ============================================================
#  LLM (текстовая модель, OpenAI-совместимый API)
# ============================================================
# Ключ провайдера: OpenAI, OpenRouter, Yandex Cloud, локальный Ollama и т.п.
LLM_API_KEY=sk-example-llm-key
# Базовый URL без завершающего слэша. Пример для OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
# Имя модели у вашего провайдера
# Бесплатный вариант (OpenRouter): nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MODEL=gpt-4o-mini
# Резервные модели через запятую — используются, если основная ответила 429/5xx
# Пример: google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
LLM_FALLBACK_MODELS=
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=600
LLM_TIMEOUT=70
# Общий бюджет на перебор моделей, сек
LLM_TOTAL_TIMEOUT=130

# ============================================================
#  Image API (картинки)
# ============================================================
# openai       -> /images/generations (DALL-E 3, gpt-image-1, любые совместимые)
# stability    -> Stability AI /v2beta/stable-image/generate/core (SDXL и др.)
# pollinations -> бесплатный Flux, ключ не нужен вообще
IMAGE_PROVIDER=pollinations
# Пусто при pollinations (не нужен) и при openai (возьмётся LLM_API_KEY)
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT=120

# ============================================================
#  Прочее
# ============================================================
LOG_LEVEL=INFO

# ============================================================
#  Хостинг
# ============================================================
# Render/Railway подставляют PORT сами — трогать не нужно.
# Задайте вручную, только если хотите поднять /healthz локально или на VPS.
# PORT=8080
